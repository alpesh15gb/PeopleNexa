// PeopleNexa — multi-tenant HR platform schema (Postgres)
// Each row is scoped by tenantId; tenant resolution happens via subdomain
// (slug.peoplenexa.in) resolved in middleware, and via the session.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant (one client / company) ─────────────────────────────────────────

model Tenant {
  id                String    @id @default(cuid())
  name              String
  code              String    @unique // corporate code, e.g. "CP26080012"
  slug              String    @unique // subdomain: crk.peoplenexa.in
  domain            String? // optional custom domain
  email             String?
  phone             String?
  address           String?
  status            String    @default("active") // active | suspended | trial

  // License (denormalized current state; history lives in License rows)
  plan              String    @default("trial") // trial | starter | growth | pro | enterprise
  seats             Int       @default(10) // max employees allowed
  subscriptionExpiry DateTime?
  config            Json?     @default("{}") // per-tenant settings (eBioserver profile, etc.)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branches    Branch[]
  departments Department[]
  shifts      Shift[]
  employees   Employee[]
  leaveTypes  LeaveType[]
  holidays    Holiday[]
  attendance  Attendance[]
  assets      Asset[]
  devices     Device[]
  modules     TenantModule[]
  licenses    License[]
  corrections PunchCorrection[]
  expenseClaims ExpenseClaim[]
  locationPings LocationPing[]
  documents   Document[]
  kpis        Kpi[]
  reviews     PerformanceReview[]
  tickets     Ticket[]
  orgPosts    OrgPost[]
  policies    Policy[]
  rosters     RosterAssignment[]
  onboardingTasks OnboardingTask[]
  exitRequests   ExitRequest[]
  webhooks    WebhookEndpoint[]
  taxDeclarations TaxDeclaration[]
  payrollAdjustments PayrollAdjustment[]
}

// ─── Super admin (platform operator, not a tenant) ─────────────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Per-tenant module flags (what a plan includes) ────────────────────────

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    String // e.g. "attendance" | "payroll" | "assets" …
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, module])
  @@index([tenantId])
}

// ─── License history (one row per grant/change) ────────────────────────────

model License {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       String
  seats      Int
  startsAt   DateTime @default(now())
  expiresAt  DateTime?
  note       String?
  createdBy  String? // superadmin id / email
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// ─── Biometric devices (ESSL ADMS / iClock + eBioserver) ──────────────────

model Device {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  serialNumber String   @unique // device serial, e.g. ESSL SN
  ipAddress    String?
  type         String   @default("biometric") // biometric | face | card
  protocol     String   @default("attlog") // attlog (iClock) | json (AI devices)
  status       String   @default("active") // active | inactive | offline
  lastSeenAt   DateTime?
  config       Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs     DeviceLog[]
  commands DeviceCommand[]
  punches  Punch[]

  @@index([tenantId])
}

model DeviceCommand {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command   String
  status    String   @default("pending") // pending | sent | executed | failed
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, status])
}

model DeviceLog {
  id        String   @id @default(cuid())
  tenantId  String
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rawData   String?
  userId    String? // employee code as enrolled on the device
  punchTime DateTime?
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([deviceId, processed])
  @@index([tenantId, punchTime])
}

// ─── Branches with GPS geofencing ──────────────────────────────────────────

model Branch {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  latitude       Float?
  longitude      Float?
  geofenceRadius Int      @default(200) // meters
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees  Employee[]
  attendance Attendance[]

  @@unique([tenantId, code])
}

model Department {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, name])
}

model Shift {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  startTime    String // "09:00"
  endTime      String // "18:00"
  graceMinutes Int     @default(15) // punch-in grace before late
  isNightShift Boolean @default(false)
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees  Employee[]
  attendance Attendance[]
  rosters    RosterAssignment[]

  @@unique([tenantId, name])
}

// ─── Employees ─────────────────────────────────────────────────────────────

model Employee {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeNumber String // e.g. EMP-001
  firstName      String
  lastName       String
  email          String
  phone          String?
  password       String // bcrypt hash
  role           String    @default("employee") // admin | employee
  status         String    @default("active") // active | inactive
  position       String?
  salary         Float?
  joiningDate    DateTime?
  profilePicture String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @updatedAt

  // Bank details for bulk salary file generation.
  bankName       String?
  accountNumber  String?
  ifscCode       String?

  // Statutory identifiers for compliance exports (ECR / Form 16 / 24Q).
  pan String?
  uan String?

  // Salary structure components (Basic / HRA / Conveyance / Medical / Other).
  salaryStructure Json?

  // Reporting line for the org chart.
  managerId String?
  manager   Employee? @relation("OrgChart", fields: [managerId], references: [id], onDelete: SetNull)
  team      Employee[] @relation("OrgChart")

  // Pay mode: monthly (default) | daily | weekly | hourly | work_basis.
  // `salary` holds the per-period rate for non-monthly modes (daily wage,
  // weekly wage, hourly rate, or per-day piece rate).
  payMode       String  @default("monthly")
  workBasisRate Float? // optional per-unit rate for work_basis mode

  taxDeclarations  TaxDeclaration[]
  payrollAdjustments PayrollAdjustment[]

  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  shiftId        String?
  shift          Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  attendance      Attendance[]
  punches         Punch[]
  leaveRequests   LeaveRequest[]
  notifications   Notification[]
  payslips        Payslip[]
  loans           EmployeeLoan[]
  assetAssignments AssetAssignment[]
  corrections     PunchCorrection[]
  expenseClaims   ExpenseClaim[]
  locationPings   LocationPing[]
  documents       Document[]
  reviews         PerformanceReview[] @relation("ReviewReviewee")
  reviewsReviewed PerformanceReview[] @relation("ReviewReviewer")
  feedbackGiven   ReviewFeedback[]
  ticketsRequested Ticket[]   @relation("TicketRequester")
  ticketsAssigned Ticket[]   @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  orgPosts        OrgPost[]
  orgComments     OrgComment[]
  rosterAssignments RosterAssignment[]
  onboardingTasks   OnboardingTask[]
  exitRequests      ExitRequest[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
}

// ─── Punches (immutable source of truth) ───────────────────────────────────
// Every raw punch — mobile, direct device (iClock) or eBioserver — lands here.
// Attendance rows are DERIVED from these by the reconciliation engine
// (lib/reconcile.ts); in/out times are never edited directly.

model Punch {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  source     String   @default("mobile") // mobile | device | ebioserver
  punchTime  DateTime
  inOutHint  String   @default("unknown") // in | out | unknown (device-reported; weak hint only)
  lat        Float?
  lng        Float?
  selfie     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, employeeId, punchTime])
}

// ─── Attendance ────────────────────────────────────────────────────────────

model Attendance {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shiftId        String?
  shift          Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  date            DateTime
  punchInTime     DateTime?
  punchOutTime    DateTime?
  punchInLat      Float?
  punchInLng      Float?
  punchOutLat     Float?
  punchOutLng     Float?
  punchInSelfie   String?
  punchOutSelfie  String?
  status          String // present | late | permission | absent | half_day
  lateMinutes     Int      @default(0)
  overtimeMinutes Int      @default(0)
  note            String?

  // Reconciliation layer (Phase 4): the punches snapshot this day was derived
  // from, whether the window has closed (finalized), and any flag raised.
  punches      Json?
  finalized    Boolean  @default(false)
  reviewStatus String? // needs_review | missed_punch | null

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

// ─── Leaves ────────────────────────────────────────────────────────────────

model LeaveType {
  id               String  @id @default(cuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  code             String
  maxDays          Int
  isCarryForward   Boolean @default(false)
  requiresApproval Boolean @default(true)
  color            String  @default("#3b82f6")
  encashable       Boolean @default(false) // unused balance is paid out (F&F / year-end)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([tenantId, code])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  fromDate    DateTime
  toDate      DateTime
  days        Float
  reason      String?
  status      String    @default("pending") // pending | approved | rejected
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  appliedAt   DateTime  @default(now())
}

// ─── Holidays ──────────────────────────────────────────────────────────────

model Holiday {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  isRecurring Boolean  @default(false)
  isHalfDay   Boolean  @default(false) // half-day holiday: only morning/afternoon off
}

// ─── Punch regularization (employee-raised corrections) ────────────────────
// Employees request a fix for a missed or wrong punch with a reason; admins
// approve/reject. On approval the attendance row is updated + reconciled.

model PunchCorrection {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime // the day being corrected
  currentIn     DateTime?
  currentOut    DateTime?
  requestedIn   DateTime?
  requestedOut  DateTime?
  reason        String
  status        String   @default("pending") // pending | approved | rejected
  reviewNote    String?
  reviewedBy    String? // admin employee id
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, date])
}

// ─── Expense & reimbursement claims ────────────────────────────────────────
// Employees submit claims (amount, category, receipt photo); admins approve
// and settle. Advances (EmployeeLoan) can be marked as settled against these.

model ExpenseClaim {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("travel") // travel | food | fuel | mobile | medical | other
  amount      Float
  description String?
  receiptUrl  String? // data URL (same pattern as punch selfies)
  status      String   @default("pending") // pending | approved | rejected | settled
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  settledAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId])
}

// ─── Payroll / Payslips ────────────────────────────────────────────────────

model Payslip {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // "2026-08"
  baseSalary Float
  allowances Float    @default(0)

  // Earnings breakdown
  overtimePay  Float @default(0)
  grossEarnings Float @default(0)
  gratuity     Float @default(0) // employer contribution (4.81% of basic)

  // Deduction breakdown (all monthly)
  pfEmployee     Float @default(0)
  pfEmployer     Float @default(0)
  esicEmployee   Float @default(0)
  esicEmployer   Float @default(0)
  professionalTax Float @default(0)
  lwf            Float @default(0)
  tds            Float @default(0)
  lateFines      Float @default(0)
  loanDeduction  Float @default(0)
  deductions     Float // total deducted (incl. statutory + fines + loans)

  // Manual adjustments (arrears / bonus / one-off deductions).
  adjustments    Json?

  // Attendance inputs that drove the calculation
  presentDays    Int    @default(0)
  lateDays       Int    @default(0)
  halfDays       Int    @default(0)
  absentDays     Int    @default(0)
  overtimeHours  Float  @default(0)
  workedHours    Float  @default(0)

  netSalary Float
  status    String   @default("draft") // draft | paid
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([tenantId, month])
}

// ─── Loans & advances ──────────────────────────────────────────────────────
// Employee advances/loans are deducted automatically from monthly payslips.
// `emiAmount` of 0 means "deduct the whole outstanding balance at once"
// (typical for small advances). `lastDeductedMonth` makes deduction
// idempotent across payroll runs.

model EmployeeLoan {
  id               String   @id @default(cuid())
  tenantId         String
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             String   @default("advance") // advance | loan
  amount           Float
  outstanding      Float
  emiCount         Int      @default(1)
  emiAmount        Float    @default(0)
  startMonth       String // "2026-08" — first month a deduction applies
  lastDeductedMonth String?
  status           String   @default("active") // active | closed
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, employeeId])
}

// ─── Asset tracking ────────────────────────────────────────────────────────

model Asset {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String   @default("other") // laptop | phone | id_card | vehicle | device | furniture | other
  tag          String? // asset tag, e.g. AST-001
  serialNumber String?
  value        Float?
  purchaseDate DateTime?
  status       String   @default("available") // available | assigned | maintenance | retired | lost
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments AssetAssignment[]

  @@unique([tenantId, tag])
  @@index([tenantId, status])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  note       String?
  assignedBy String? // admin employee id who issued the asset
  createdAt  DateTime  @default(now())

  @@index([assetId, returnedAt])
  @@index([employeeId, returnedAt])
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // info | success | warning | danger
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
}

// ─── Journey tracker (field workforce GPS) ────────────────────────────────
// Location pings streamed from the employee app while on duty; admins replay
// the day's route and see distance traveled.

model LocationPing {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float? // metres
  source     String   @default("app") // app | manual
  at         DateTime // when the ping was captured
  createdAt  DateTime @default(now())

  @@index([tenantId, employeeId, at])
}

// ─── Document management (visa/passport/Aadhaar, expiry alerts) ────────────

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String // e.g. "Passport", "Aadhaar card"
  docType     String   @default("other") // passport | visa | aadhaar | pan | license | other
  number      String? // document number (masked in views)
  issuedDate  DateTime?
  expiryDate  DateTime?
  fileUrl     String? // data URL (image/PDF)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, expiryDate])
  @@index([employeeId])
}

// ─── Performance management (KPIs + appraisals + 360° feedback) ────────────

model Kpi {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String   @default("core") // core | skill | behavior
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  scores ReviewScore[]
  @@index([tenantId])
}

model PerformanceReview {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation("ReviewReviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId  String? // manager/admin who completes it
  reviewer    Employee? @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  period      String // e.g. "Q3 2026" or "H2 2026"
  status      String    @default("draft") // draft | self_done | completed
  selfSummary String?
  managerSummary String?
  overallRating Int? // 1–5
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  scores    ReviewScore[]
  feedbacks ReviewFeedback[]

  @@unique([tenantId, employeeId, period])
  @@index([tenantId, status])
}

model ReviewScore {
  id            String           @id @default(cuid())
  reviewId      String
  review        PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kpiId         String
  kpi           Kpi              @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  selfScore     Int?
  managerScore  Int?
  managerComment String?
  updatedAt     DateTime         @updatedAt

  @@unique([reviewId, kpiId])
}

model ReviewFeedback {
  id        String           @id @default(cuid())
  reviewId  String
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  raterId   String // employee who gave the feedback (peer 360°)
  rater     Employee         @relation(fields: [raterId], references: [id], onDelete: Cascade)
  comment   String
  rating    Int? // 1–5 optional
  createdAt DateTime         @default(now())

  @@index([reviewId])
}

// ─── Helpdesk / ticketing ──────────────────────────────────────────────────

model Ticket {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterId String
  requester   Employee  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    Employee? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject     String
  description String
  category    String    @default("general") // general | payroll | attendance | device | it | other
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("open") // open | in_progress | resolved | closed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  messages TicketMessage[]
  @@index([tenantId, status])
  @@index([requesterId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Employee @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Org feed (announcements + posts + comments) ───────────────────────────

model OrgPost {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isAnnouncement Boolean  @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  comments OrgComment[]
  @@index([tenantId, createdAt])
}

model OrgComment {
  id        String   @id @default(cuid())
  postId    String
  post      OrgPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// ─── Policy engine (company policies, versioned) ───────────────────────────

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("general") // general | attendance | leave | payroll | conduct | it | safety
  body      String
  version   Int      @default(1)
  active    Boolean  @default(true)
  createdBy String? // admin employee id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

// ─── Shift rosters (weekly schedules) ──────────────────────────────────────
// One assignment per employee per day; the roster shift drives reconciliation
// for that day (overrides the employee's default shift).

model RosterAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date       DateTime // the IST day
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
}

// ─── Onboarding checklist (first-day flow) ─────────────────────────────────

model OnboardingTask {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("pending") // pending | done
  dueBy       DateTime?
  createdBy   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, employeeId])
}

// ─── Exit management (resignation → full & final) ──────────────────────────

model ExitRequest {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason         String
  resignationDate DateTime
  lastWorkingDay  DateTime
  status         String   @default("pending") // pending | approved | completed | cancelled
  note           String?
  reviewedBy     String?
  reviewedAt     DateTime?
  fAndF          Json? // computed full & final summary
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
}

// ─── Outbound webhooks (partner integrations) ──────────────────────────────

model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  url       String
  events    String // comma-separated: punch.created,leave.approved,...
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Tax declarations (investment proofs → TDS) ────────────────────────────
// Employees declare investments for a financial year (e.g. 80C, 80D, HRA, LTA);
// the verified total reduces taxable income in the TDS calculation.

model TaxDeclaration {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fy         String // "2026-27"
  sections   Json // { "80c": 0, "80d": 0, "hra": 0, "lta": 0, "other": 0, "total": n }
  status     String   @default("submitted") // submitted | verified | rejected
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, fy])
  @@index([tenantId, fy])
}

// ─── Manual payroll adjustments (arrears / bonus / one-off deductions) ─────
// Positive amounts add to gross earnings, negative amounts add to deductions.
// Included in the month's payslip when payroll is generated.

model PayrollAdjustment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // "2026-08"
  type       String   @default("other") // arrears | bonus | deduction | other
  label      String
  amount     Float // positive = earning, negative = deduction
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, month])
}

// ─── Plan overrides (superadmin pricing / module edits) ─────────────────────
// One row per plan key when a super admin has customized the plan. Absent rows
// mean the code defaults in lib/modules.ts apply. Null fields fall back to the
// code default; modules, when non-empty, replaces the plan's module set.

model PlanOverride {
  planKey            String    @id
  label              String?
  pricePerSeat       Int?
  annualPricePerSeat Int?
  trialDays          Int?
  seats              Int?
  modules            String[]
  updatedBy          String?
  updatedAt          DateTime  @updatedAt
}
