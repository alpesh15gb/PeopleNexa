# ── PeopleNexa app secrets (feeds the app container) ──────────────────────
# Copy to `.env.production` on the VPS (same dir as docker-compose.yml).
# Generate values with:  openssl rand -hex 32

# Base domain used for tenant subdomains (crk.peoplenexa.in). The wildcard
# DNS record (*.peoplenexa.in) must point at this server.
APP_BASE_DOMAIN=peoplenexa.in

# Session signing secret — change this and every logged-in session is invalidated.
JWT_SECRET=replace-with-a-long-random-secret

# Encryption key for eBioserver credentials stored in tenant config.
EBIO_ENCRYPTION_KEY=replace-with-64-hex-characters

# Protects /api/cron/* endpoints (the eBioserver pull job).
CRON_SECRET=replace-with-a-long-random-secret

# First boot only for a disposable/demo environment. Production startup refuses
# destructive seed unless ALLOW_DESTRUCTIVE_SEED=true is also set.
# SEED_DB=false
# ALLOW_DESTRUCTIVE_SEED=false

# Super admin account created by the seed. These values are required for any
# intentional production seed and must never use demo defaults.
# SUPERADMIN_EMAIL=admin@peoplenexa.in
# SUPERADMIN_PASSWORD=replace-with-a-long-random-password
# DEMO_ADMIN_PASSWORD=replace-with-a-long-random-password
# DEMO_EMPLOYEE_PASSWORD=replace-with-a-long-random-password
