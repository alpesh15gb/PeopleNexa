# ── PeopleNexa production environment ──────────────────────────────────────
# Copy to `.env.production` and fill in real values:
#   cp .env.production.example .env.production
# Do NOT commit the real file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Base domain for tenant subdomains (crk.<domain>). Defaults to peoplenexa.in.
APP_BASE_DOMAIN=peoplenexa.in

# JWT signing secret for sessions — REQUIRED, generate a long random value.
JWT_SECRET=

# AES key used to encrypt the eBioserver web-service password at rest.
# Must be a 32-byte key (64 hex chars) if you want the stored credentials to
# survive restarts.
EBIO_ENCRYPTION_KEY=

# Shared secret for the /api/cron/ebioserver-pull endpoint (curl -H "x-cron-secret: ...").
CRON_SECRET=

# Set to true on the very first boot to load the demo tenant (Apex Integrations
# with employees, attendance history, leaves, payroll, loans). Afterwards set
# to false so restarts don't wipe/re-seed your data.
SEED_DB=false

# NOTE: DATABASE_URL is injected by docker-compose.yml from POSTGRES_* in .env —
# do not set it here unless you know what you're doing.
