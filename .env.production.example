# ── PeopleNexa app secrets (feeds the app container) ──────────────────────
# Copy to `.env.production` on the VPS (same dir as docker-compose.yml).
# Generate values with:  openssl rand -hex 32

# Base domain used for tenant subdomains (crk.peoplenexa.in). The wildcard
# DNS record (*.peoplenexa.in) must point at this server.
APP_BASE_DOMAIN=peoplenexa.in

# Session signing secret — change this and every logged-in session is invalidated.
JWT_SECRET=change-me

# Encryption key for eBioserver credentials stored in tenant config.
EBIO_ENCRYPTION_KEY=change-me

# Protects /api/cron/* endpoints (the eBioserver pull job).
CRON_SECRET=change-me

# First boot only: seed the demo tenant (crk) + super admin, then set to false.
# SEED_DB=true

# Super admin account created by the seed. If unset, the seed falls back to
# superadmin@peoplenexa.in / superadmin123 — always override in production!
# SUPERADMIN_EMAIL=admin@peoplenexa.in
# SUPERADMIN_PASSWORD=change-me
