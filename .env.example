# ── docker-compose interpolation (this file feeds compose's ${POSTGRES_*} ──
# Copy to `.env` (same directory as docker-compose.yml) and set a strong
# database password:
#   cp .env.example .env
#
# The app container gets DATABASE_URL built from these values automatically;
# make sure POSTGRES_PASSWORD here matches nothing else — it is used verbatim
# in the connection string.

POSTGRES_USER=peoplenexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peoplenexa

# Host port the app container binds to (nginx proxies to this). Default 3000.
# APP_PORT=3000

# ── Journey Tracker map (client, baked at build time) ───────────────────────
# Google Maps API key for the admin Journey Tracker. When set (and present at
# `next build`/`next dev` time — NEXT_PUBLIC_* vars are inlined into client
# JS), the map renders Google Maps (roadmap + route polylines + markers).
# When empty or unset, the tracker keeps the built-in Leaflet/OpenStreetMap
# fallback (leaflet dep stays, no API changes).
# Get a key: https://console.cloud.google.com/apis/credentials (Maps JavaScript API).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-key
