# ── docker-compose interpolation (this file feeds compose's ${POSTGRES_*} ──
# Copy to `.env` (same directory as docker-compose.yml) and set a strong
# database password:
#   cp .env.example .env
#
# The app container gets DATABASE_URL built from these values automatically;
# make sure POSTGRES_PASSWORD here matches nothing else — it is used verbatim
# in the connection string.

POSTGRES_USER=peoplenexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peoplenexa

# Host port the app container binds to (nginx proxies to this). Default 3000.
# APP_PORT=3000
